## Ollama Production Configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434
# For local development: OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

## Application & Security Mode
APP_ENV=production
DEBUG=False
LOG_LEVEL=WARNING
USE_MOCK_DATA=False
EXECUTION_MODE=production
DEFAULT_THEME=dark

## Guardrails Production Configuration
CONFIDENCE_THRESHOLD=0.75
FACT_CHECK_ENABLED=True
DISCLAIMER_REQUIRED=True

## Vector Database & n8n Production Integration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=loan_advisor_rag
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/loan-advisor-query
USE_N8N_PIPELINE=true
EMBEDDING_MODEL=nomic-embed-text

## Dashboard Production Host & Port Settings
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000