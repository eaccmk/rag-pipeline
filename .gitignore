# ==========================================
# Python Ignore Patterns
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# Unit Test & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
pytestdebug.log

# ==========================================
# Environment Variables & Local Secrets
# ==========================================
.env
.env.local
.env.development.local
.env.test.local

# Allow example and production template env files
!.env.example
!.env.prod

# ==========================================
# Logs & Database Storage
# ==========================================
logs/*.log
logs/*.json
!logs/.gitkeep
*.sqlite
*.sqlite3
*.db

