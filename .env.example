## LLM and Ollama Server Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
EMBEDDING_MODEL=nomic-embed-text

## Application & Data Mode
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
USE_MOCK_DATA=False
EXECUTION_MODE=local
DEFAULT_THEME=dark

## Guardrails Configuration
CONFIDENCE_THRESHOLD=0.7
FACT_CHECK_ENABLED=True
DISCLAIMER_REQUIRED=True

## Vector Database & n8n Integration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=loan_advisor_rag
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/loan-advisor-query
USE_N8N_PIPELINE=false

## Dashboard Configuration & Settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
