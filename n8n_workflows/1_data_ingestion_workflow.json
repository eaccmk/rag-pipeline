{
  "name": "1. Smart Loan Advisor - Data Ingestion & Vector Indexing",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "node-schedule-trigger",
      "name": "Schedule Trigger (24h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {},
      "id": "node-manual-trigger",
      "name": "When clicking \"Test workflow\"",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        200,
        140
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/market_data",
        "options": {}
      },
      "id": "node-fetch-market-data",
      "name": "Fetch Market & CDR Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        220
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8000/api/mcp/business-loans",
        "options": {}
      },
      "id": "node-fetch-bank-loans",
      "name": "Fetch Open Banking MCP Loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const marketData = $('Fetch Market & CDR Data').first().json;\nconst bankLoans = $('Fetch Open Banking MCP Loans').first().json;\n\nconst rba = marketData.rba || {};\nconst sentiment = marketData.sentiment || {};\nconst customer = marketData.customer || {};\nconst loansList = bankLoans.top_recommendations || [];\n\nconst documents = [\n  {\n    json: {\n      pageContent: `CUSTOMER PROFILE & CURRENT LOANS:\\nCustomer ID: ${customer.customer_id || 'CUST_001'}\\nCurrent Loans: ${JSON.stringify(customer.loans || [])}\\nRisk Rating: ${customer.credit_score || 'Good'}`,\n      metadata: { source: \"customer_cdr_mcp\", category: \"customer_profile\" }\n    }\n  },\n  {\n    json: {\n      pageContent: `RBA CASH RATE & MONETARY SIGNALS:\\nCurrent Cash Rate: ${rba.cash_rate || '4.35%'}\\nRate Outlook: ${rba.outlook || 'Neutral/Hawkish'}\\nLast Statement: ${rba.last_statement || 'Inflation remains above target range.'}`,\n      metadata: { source: \"rba_service\", category: \"macro_economics\" }\n    }\n  },\n  {\n    json: {\n      pageContent: `MARKET SENTIMENT ANALYSIS:\\nSentiment Score: ${sentiment.score || 0.65}\\nSentiment Summary: ${sentiment.summary || 'Market expects interest rates to hold steady before potential easing.'}`,\n      metadata: { source: \"sentiment_service\", category: \"market_insights\" }\n    }\n  },\n  {\n    json: {\n      pageContent: `TOP RECOMMENDED BANK BUSINESS LOAN PRODUCTS (open-banking-mcp):\\n${loansList.map(l => `- ${l.bank_name || l.name}: ${l.product_name} @ ${l.interest_rate}% (Comparison: ${l.comparison_rate}%). Features: ${l.features?.join(', ')}`).join('\\n')}`,\n      metadata: { source: \"open_banking_mcp\", category: \"bank_comparison\" }\n    }\n  }\n];\n\nreturn documents;"
      },
      "id": "node-prepare-documents",
      "name": "Prepare Context Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        220
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "node-default-data-loader",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1,
      "position": [
        1140,
        340
      ]
    },
    {
      "parameters": {
        "chunkSize": 500,
        "chunkOverlap": 100
      },
      "id": "node-text-splitter",
      "name": "Recursive Character Text Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        1140,
        500
      ]
    },
    {
      "parameters": {
        "model": "llama3.2:1b",
        "baseUrl": "http://host.docker.internal:11434"
      },
      "id": "node-ollama-embeddings",
      "name": "Embeddings Ollama",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOllama",
      "typeVersion": 1,
      "position": [
        1140,
        180
      ]
    },
    {
      "parameters": {
        "mode": "insert",
        "qdrantCollection": {
          "__rl": true,
          "value": "loan_advisor_rag",
          "mode": "list"
        },
        "options": {
          "qdrantUrl": "http://host.docker.internal:6333"
        }
      },
      "id": "node-qdrant-vector-store",
      "name": "Qdrant Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1,
      "position": [
        1360,
        220
      ]
    }
  ],
  "connections": {
    "When clicking \"Test workflow\"": {
      "main": [
        [
          {
            "node": "Fetch Market & CDR Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Trigger (24h)": {
      "main": [
        [
          {
            "node": "Fetch Market & CDR Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Market & CDR Data": {
      "main": [
        [
          {
            "node": "Fetch Open Banking MCP Loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Open Banking MCP Loans": {
      "main": [
        [
          {
            "node": "Prepare Context Documents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Context Documents": {
      "main": [
        [
          {
            "node": "Qdrant Vector Store",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Default Data Loader": {
      "ai_document": [
        [
          {
            "node": "Qdrant Vector Store",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    },
    "Recursive Character Text Splitter": {
      "ai_textSplitter": [
        [
          {
            "node": "Default Data Loader",
            "type": "ai_textSplitter",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings Ollama": {
      "ai_embedding": [
        [
          {
            "node": "Qdrant Vector Store",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}